---
import { Image } from 'astro:assets';
import icon from '../assets/brand/icon.png';

const links = [
	{ href: '/#how', label: 'Как это работает' },
	{ href: '/#topics', label: 'Темы' },
	{ href: '/#parents', label: 'Родителям' },
	{ href: '/#gallery', label: 'Галерея' },
	{ href: '/#faq', label: 'Вопросы' },
	{ href: '/#contacts', label: 'Контакты' },
];
---

<header class="header" data-header>
	<div class="container header__inner">
		<a class="header__logo" href="/" aria-label="LangoLand — на главную">
			<Image src={icon} alt="" width={40} height={40} densities={[1, 2]} loading="eager" />
			<span class="wordmark"><span class="wordmark__a">Lango</span><span class="wordmark__b">Land</span></span>
		</a>
		<nav class="header__nav" aria-label="Разделы">
			<ul>
				{links.map((link) => <li><a href={link.href}>{link.label}</a></li>)}
			</ul>
		</nav>
		<a class="header__cta" href="/#download">Скачать</a>
	</div>
</header>

<script>
	const header = document.querySelector<HTMLElement>('[data-header]');
	if (header) {
		const update = () => header.classList.toggle('is-scrolled', window.scrollY > 8);
		update();
		window.addEventListener('scroll', update, { passive: true });
	}
</script>

<style>
	.header {
		position: fixed;
		inset: 0 0 auto;
		z-index: 50;
		transition:
			background-color 0.25s ease,
			box-shadow 0.25s ease;
	}
	.header.is-scrolled {
		background: rgb(46 26 138 / 0.82);
		box-shadow: 0 8px 24px -16px rgb(10 5 40 / 0.6);
		backdrop-filter: blur(14px) saturate(140%);
		-webkit-backdrop-filter: blur(14px) saturate(140%);
	}
	.header__inner {
		display: flex;
		align-items: center;
		gap: 1.5rem;
		height: 4.25rem;
	}
	.header__logo {
		display: flex;
		align-items: center;
		gap: 0.6rem;
		margin-right: auto;
		font-size: 1.375rem;
		text-decoration: none;
	}
	.header__logo img {
		width: 40px;
		height: 40px;
		border-radius: 12px;
		box-shadow: 0 0 0 2px rgb(255 255 255 / 0.35);
	}
	.header__nav ul {
		display: flex;
		gap: 0.25rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}
	.header__nav a {
		display: block;
		padding: 0.45rem 0.8rem;
		border-radius: 999px;
		color: rgb(255 255 255 / 0.88);
		font-size: 0.9375rem;
		font-weight: 700;
		text-decoration: none;
		transition: background-color 0.2s ease;
	}
	.header__nav a:hover {
		background: rgb(255 255 255 / 0.14);
		color: #fff;
	}
	.header__cta {
		padding: 0.5rem 1.1rem;
		border-radius: 999px;
		background: var(--lime);
		color: #1d2a00;
		font-weight: 850;
		text-decoration: none;
		box-shadow: 0 6px 16px -6px rgb(120 170 0 / 0.8);
		transition: transform 0.15s ease;
	}
	.header__cta:hover {
		transform: translateY(-1px);
	}
	@media (max-width: 64rem) {
		.header__nav {
			display: none;
		}
	}
</style>
