---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';

interface Props {
	title?: string;
	description?: string;
	appSchema?: boolean;
}

const head = Astro.props;
---

<!doctype html>
<html lang="ru">
	<head>
		<BaseHead {...head} />
	</head>
	<body>
		<a class="skip-link" href="#main">К содержанию</a>
		<Header />
		<main id="main">
			<slot />
		</main>
		<Footer />
	</body>
</html>
